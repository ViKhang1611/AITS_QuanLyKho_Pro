@* Assign material to cell modal *@

@if (showAssignModal && assignCell != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal" @onclick:stopPropagation="true" style="min-width:400px;max-height:80vh;overflow-y:auto">
            <div class="modal-title">📦 Gán vật tư vào ô @($"{selShelf?.Level}.{assignCell.Position}")</div>
            <input type="text" placeholder="🔍 Tìm vật tư..." @bind="matSearch" @bind:event="oninput"
                   style="width:100%;padding:8px 12px;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;margin-bottom:12px" />
            <div style="max-height:340px;overflow-y:auto;display:flex;flex-direction:column;gap:6px">
                @foreach (var m in FilteredMaterials)
                {
                    var mat = m;
                    <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 12px;border:1px solid #e2e8f0;border-radius:8px;cursor:pointer;transition:all .15s"
                         @onclick="()=>AssignMaterial(mat)"
                         onmouseover="this.style.background='#eff6ff'" onmouseout="this.style.background=''">
                        <div>
                            <div style="font-weight:600;font-size:13px">@mat.Name</div>
                            <div style="font-size:11px;color:#64748b">@mat.Code · @mat.Quantity @mat.Unit</div>
                        </div>
                        <span style="font-size:11px;color:#3b82f6;font-weight:600">Chọn →</span>
                    </div>
                }
                @if (!FilteredMaterials.Any())
                {
                    <div style="text-align:center;color:#94a3b8;padding:20px;font-style:italic">Không tìm thấy vật tư</div>
                }
            </div>
            <div class="modal-footer" style="margin-top:12px">
                <button class="btn btn-outline" @onclick="CloseModals">Hủy</button>
            </div>
        </div>
    </div>
}

@* Delete confirmation modal *@
@if (showDeleteModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal text-center" style="max-width:420px" @onclick:stopPropagation="true">
            <div class="modal-title text-red" style="font-size:18px">🗑️ Xác nhận xóa</div>
            <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:12px 16px;margin:12px 0;color:#991b1b;font-size:13px">
                @deleteMsg
            </div>
            <div class="modal-footer justify-between">
                <button class="btn btn-outline" @onclick="CloseModals">Hủy</button>
                <button class="btn" style="background:#dc2626;color:#fff" @onclick="ConfirmDelete">Xác nhận xóa</button>
            </div>
        </div>
    </div>
}

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    List<StorageZone> zones = [];
    List<Material> materials = [];

    List<Material> GetMaterialsInCell(StorageCell c)
    {
        if (selZone == null || selRack == null || selShelf == null) return [];
        var locStr1 = $"{selZone.Code} > {selRack.Code} > {selShelf.Level} > {c.Position}";
        var locStr2 = $"{selZone.Code} > {selRack.Code} > Tầng {selShelf.Level} > Ô {c.Position}";

        return materials.Where(m =>
            (c.MaterialId.HasValue && m.Id == c.MaterialId.Value) ||
            (!string.IsNullOrEmpty(m.Location) && (m.Location == locStr1 || m.Location == locStr2 || m.Location.Contains(locStr1)))
        ).DistinctBy(m => m.Id).ToList();
    }
    int level = 0;                  // 0=zones, 1=racks, 2=shelves, 3=cells
    StorageZone? selZone;
    StorageRack? selRack;
    StorageShelf? selShelf;

    // ── Zone modal ────────────────────────────────────────────────────────────
    bool showZoneModal;
    StorageZone zoneForm = new();
    static readonly string[] zoneColors = ["#3b82f6","#10b981","#8b5cf6","#f59e0b","#ef4444","#06b6d4","#ec4899","#84cc16"];

    // ── Rack modal ────────────────────────────────────────────────────────────
    bool showRackModal;
    StorageRack rackForm = new();

    // ── Shelf modal ───────────────────────────────────────────────────────────
    bool showShelfModal;
    StorageShelf shelfForm = new();

    // ── Cell modal ────────────────────────────────────────────────────────────
    bool showCellModal;
    StorageCell cellForm = new();

    // ── Assign modal ──────────────────────────────────────────────────────────
    bool showAssignModal;
    StorageCell? assignCell;
    string matSearch = "";
    IEnumerable<Material> FilteredMaterials => materials.Where(m =>
        string.IsNullOrEmpty(matSearch) ||
        m.Name.Contains(matSearch, StringComparison.OrdinalIgnoreCase) ||
        m.Code.Contains(matSearch, StringComparison.OrdinalIgnoreCase));

    // ── Delete modal ──────────────────────────────────────────────────────────
    bool showDeleteModal;
    string deleteMsg = "";
    Func<Task>? deleteAction;

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync() => await Reload();

    async Task Reload()
    {
        zones = await Svc.GetZonesAsync() ?? [];
        materials = await Svc.GetMaterialsAsync() ?? [];
        // Refresh selected objects from fresh data
        if (selZone != null) selZone = zones.FirstOrDefault(z => z.Id == selZone.Id);
        if (selZone != null && selRack != null) selRack = (selZone.Racks ?? []).FirstOrDefault(r => r.Id == selRack.Id);
        if (selRack != null && selShelf != null) selShelf = (selRack.Shelves ?? []).FirstOrDefault(s => s.Id == selShelf.Id);
        // Go back level if selection lost
        if (level == 1 && selZone == null) level = 0;
        if (level == 2 && selRack == null) level = 1;
        if (level == 3 && selShelf == null) level = 2;
    }

    // ── Navigation ────────────────────────────────────────────────────────────
    void GoLevel(int l)
    {
        if (l < level) level = l;
        if (level == 0) { selZone = null; selRack = null; selShelf = null; }
        else if (level == 1) { selRack = null; selShelf = null; }
        else if (level == 2) { selShelf = null; }
    }

    void SelectZone(StorageZone z) { selZone = z; level = 1; }
    void SelectRack(StorageRack r) { selRack = r; level = 2; }
    void SelectShelf(StorageShelf s) { selShelf = s; level = 3; }

    // ── Zone CRUD ─────────────────────────────────────────────────────────────
    void OpenAddZone() { zoneForm = new StorageZone { Color = "#3b82f6" }; showZoneModal = true; }
    void OpenEditZone(StorageZone z) { zoneForm = new StorageZone { Id=z.Id, Code=z.Code, Name=z.Name, Description=z.Description, Color=z.Color }; showZoneModal = true; }

    async Task SaveZone()
    {
        if (string.IsNullOrWhiteSpace(zoneForm.Code) || string.IsNullOrWhiteSpace(zoneForm.Name)) return;
        if (zoneForm.Id == 0) await Svc.AddZoneAsync(zoneForm);
        else await Svc.UpdateZoneAsync(zoneForm);
        await Reload(); CloseModals();
    }

    void ConfirmDeleteZone(StorageZone z)
    {
        deleteMsg = $"Xóa khu vực \"{z.Code} - {z.Name}\" sẽ xóa toàn bộ kệ, tầng và ô bên trong. Không thể hoàn tác!";
        deleteAction = async () => { await Svc.DeleteZoneAsync(z.Id); GoLevel(0); await Reload(); };
        showDeleteModal = true;
    }

    // ── Rack CRUD ─────────────────────────────────────────────────────────────
    void OpenAddRack() { rackForm = new StorageRack { ZoneId = selZone!.Id }; showRackModal = true; }
    void OpenEditRack(StorageRack r) { rackForm = new StorageRack { Id=r.Id, Code=r.Code, Name=r.Name, Description=r.Description, ZoneId=r.ZoneId }; showRackModal = true; }

    async Task SaveRack()
    {
        if (string.IsNullOrWhiteSpace(rackForm.Code)) return;
        rackForm.ZoneId = selZone!.Id;
        if (string.IsNullOrWhiteSpace(rackForm.Name)) rackForm.Name = $"Kệ {rackForm.Code}";
        if (rackForm.Id == 0) await Svc.AddRackAsync(rackForm);
        else await Svc.UpdateRackAsync(rackForm);
        await Reload(); CloseModals();
    }

    void ConfirmDeleteRack(StorageRack r)
    {
        deleteMsg = $"Xóa kệ \"{r.Code}\" sẽ xóa toàn bộ tầng và ô bên trong. Không thể hoàn tác!";
        deleteAction = async () => { await Svc.DeleteRackAsync(r.Id); GoLevel(1); await Reload(); };
        showDeleteModal = true;
    }

    // ── Shelf CRUD ────────────────────────────────────────────────────────────
    void OpenAddShelf() { shelfForm = new StorageShelf { RackId = selRack!.Id }; showShelfModal = true; }
    void OpenEditShelf(StorageShelf s) { shelfForm = new StorageShelf { Id=s.Id, Level=s.Level, RackId=s.RackId, SortOrder=s.SortOrder }; showShelfModal = true; }

    async Task SaveShelf()
    {
        if (string.IsNullOrWhiteSpace(shelfForm.Level)) return;
        shelfForm.RackId = selRack!.Id;
        if (shelfForm.Id == 0) await Svc.AddShelfAsync(shelfForm);
        else await Svc.UpdateShelfAsync(shelfForm);
        await Reload(); CloseModals();
    }

    void ConfirmDeleteShelf(StorageShelf s)
    {
        deleteMsg = $"Xóa tầng \"{s.Level}\" sẽ xóa toàn bộ ô bên trong. Không thể hoàn tác!";
        deleteAction = async () => { await Svc.DeleteShelfAsync(s.Id); GoLevel(2); await Reload(); };
        showDeleteModal = true;
    }

    // ── Cell CRUD ─────────────────────────────────────────────────────────────
    void OpenAddCell() { cellForm = new StorageCell { ShelfId = selShelf!.Id }; showCellModal = true; }
    void OpenEditCell(StorageCell c) { cellForm = new StorageCell { Id=c.Id, Position=c.Position, Note=c.Note, ShelfId=c.ShelfId, MaterialId=c.MaterialId }; showCellModal = true; }

    async Task SaveCell()
    {
        if (string.IsNullOrWhiteSpace(cellForm.Position)) return;
        cellForm.ShelfId = selShelf!.Id;
        if (cellForm.Id == 0) await Svc.AddCellAsync(cellForm);
        else await Svc.UpdateCellAsync(cellForm);
        await Reload(); CloseModals();
    }

    void ConfirmDeleteCell(StorageCell c)
    {
        deleteMsg = $"Xóa ô \"{selShelf?.Level}.{c.Position}\"? Thao tác này không thể hoàn tác.";
        deleteAction = async () => { await Svc.DeleteCellAsync(c.Id); await Reload(); };
        showDeleteModal = true;
    }

    void ClearCellConfirm(StorageCell c)
    {
        deleteMsg = $"Dọn trống ô \"{selShelf?.Level}.{c.Position}\" - xóa liên kết vật tư \"{c.MaterialName}\"?";
        deleteAction = async () => { await Svc.AssignMaterialToCellAsync(c.Id, null); await Reload(); };
        showDeleteModal = true;
    }

    // ── Assign Material ───────────────────────────────────────────────────────
    void OpenAssignCell(StorageCell c) { assignCell = c; matSearch = ""; showAssignModal = true; }

    async Task AssignMaterial(Material mat)
    {
        if (assignCell == null) return;
        await Svc.AssignMaterialToCellAsync(assignCell.Id, mat);
        await Reload(); CloseModals();
    }

    // ── Delete ────────────────────────────────────────────────────────────────
    async Task ConfirmDelete()
    {
        if (deleteAction != null) await deleteAction();
        CloseModals();
    }

    void CloseModals()
    {
        showZoneModal = showRackModal = showShelfModal = showCellModal = showAssignModal = showDeleteModal = false;
        deleteAction = null;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    static string GetDotClass(string status) => status switch
    {
        "ok" => "cell-dot-ok",
        "low" => "cell-dot-low",
        "expiring" => "cell-dot-expiring",
        _ => "cell-dot-empty"
    };

    static string GetChipClass(string status) => status switch
    {
        "ok" => "chip-ok",
        "low" => "chip-low",
        "expiring" => "chip-expiring",
        _ => "chip-empty"
    };

    static string DarkenHex(string hex)
    {
        // Simple darkening for gradient
        try
        {
            var h = hex.TrimStart('#');
            int r = Convert.ToInt32(h[..2], 16);
            int g = Convert.ToInt32(h[2..4], 16);
            int b = Convert.ToInt32(h[4..6], 16);
            return $"#{Math.Max(0,r-50):X2}{Math.Max(0,g-50):X2}{Math.Max(0,b-50):X2}";
        }
        catch { return hex; }
    }
}
